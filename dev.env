USER_SERVICE_URL=http://user-service:8082
MESSAGE_SERVICE_URL=http://message-service:8083
SYNC_SERVICE_URL=http://sync-service:8084
MEDIA_SERVICE_URL=http://media-service:8086

# Admin Service
ADMIN_SERVICE_PORT=8085
ADMIN_SERVICE_IMAGE=ghcr.io/borshchevyk/dev-borshchevyk-backend/admin-service:latest
ADMIN_USERNAME=gemini
