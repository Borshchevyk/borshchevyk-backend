# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_DB_NAMES=borshchevyk_auth,borshchevyk_user,borshchevyk_message,borshchevyk_sync,borshchevyk_media

# Kafka Configuration
KAFKA_BROKER_ID=1
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1

# Spring Datasource
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Services configuration
DOMAIN_NAME=dev.borshchevik.su
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
GATEWAY_INTERNAL_PORT=8080
GATEWAY_SERVICE_IMAGE=ghcr.io/borshchevyk/dev-borshchevyk-backend/gateway-service:latest

AUTH_SERVICE_PORT=8081
AUTH_SERVICE_NAME=borshchevyk.auth
SPRING_DATASOURCE_URL_AUTH=jdbc:postgresql://borshchevyk-postgres:5432/borshchevyk_auth
AUTH_SERVICE_IMAGE=ghcr.io/borshchevyk/dev-borshchevyk-backend/auth-service:latest

MEDIA_SERVICE_PORT=8086
MEDIA_SERVICE_NAME=borshchevyk.media
SPRING_DATASOURCE_URL_MEDIA=jdbc:postgresql://borshchevyk-postgres:5432/borshchevyk_media
MEDIA_SERVICE_IMAGE=ghcr.io/borshchevyk/dev-borshchevyk-backend/media-service:latest

USER_SERVICE_PORT=8082
USER_SERVICE_NAME=borshchevyk.user
SPRING_DATASOURCE_URL_USER=jdbc:postgresql://borshchevyk-postgres:5432/borshchevyk_user
USER_SERVICE_IMAGE=ghcr.io/borshchevyk/dev-borshchevyk-backend/user-service:latest

MESSAGE_SERVICE_PORT=8083
MESSAGE_SERVICE_NAME=borshchevyk.message
SPRING_DATASOURCE_URL_MESSAGE=jdbc:postgresql://borshchevyk-postgres:5432/borshchevyk_message
MESSAGE_SERVICE_IMAGE=ghcr.io/borshchevyk/dev-borshchevyk-backend/message-service:latest

SYNC_SERVICE_PORT=8084
SYNC_SERVICE_NAME=borshchevyk.sync
SPRING_DATASOURCE_URL_SYNC=jdbc:postgresql://borshchevyk-postgres:5432/borshchevyk_sync
SYNC_SERVICE_IMAGE=ghcr.io/borshchevyk/dev-borshchevyk-backend/sync-service:latest

# Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_PRODUCER_KEY_SERIALIZER=org.apache.kafka.common.serialization.StringSerializer
KAFKA_PRODUCER_VALUE_SERIALIZER=org.apache.kafka.common.serialization.StringSerializer
KAFKA_TOPIC_USER_REGISTERED=user-registered-events
KAFKA_TOPIC_USER_UPDATED=user-updated-events
KAFKA_TOPIC_USER_DELETED=user-deleted-events

# Redis
SPRING_REDIS_HOST=borshchevyk-redis
SPRING_REDIS_PORT=6379

# JPA
JPA_HIBERNATE_DDL-AUTO=update
JPA_DATABASE=postgresql

# JWT
JWT_SECRET=Qm9yc2hjaGV2eWtTdXBlclNlY3JldEtleUZvckp3dEF1dGhlbnRpY2F0aW9uTXVzdEJlTG9uZ0Vub3VnaDEyMzQ1IQ==
JWT_ACCESS_EXPIRATION_MS=3600000
