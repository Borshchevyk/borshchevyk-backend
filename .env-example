# Database Configuration
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
POSTGRES_DB_NAMES=borshchevyk_auth,borshchevyk_user,borshchevyk_message,borshchevyk_sync

# Kafka Configuration
KAFKA_BROKER_ID=
ZOOKEEPER_CLIENT_PORT=
ZOOKEEPER_TICK_TIME=
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1

# Spring Datasource
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Services configuration
DOMAIN_NAME=borshchevik.su
CADDY_HTTP_PORT=
CADDY_HTTPS_PORT=
GATEWAY_INTERNAL_PORT=
GATEWAY_SERVICE_IMAGE=

AUTH_SERVICE_PORT=
AUTH_SERVICE_NAME=borshchevyk.auth
SPRING_DATASOURCE_URL_AUTH=
AUTH_SERVICE_IMAGE=

USER_SERVICE_PORT=
USER_SERVICE_NAME=borshchevyk.user
SPRING_DATASOURCE_URL_USER=
USER_SERVICE_IMAGE=

MESSAGE_SERVICE_PORT=
MESSAGE_SERVICE_NAME=borshchevyk.message
SPRING_DATASOURCE_URL_MESSAGE=
MESSAGE_SERVICE_IMAGE=

SYNC_SERVICE_PORT=
SYNC_SERVICE_NAME=borshchevyk.sync
SPRING_DATASOURCE_URL_SYNC=
SYNC_SERVICE_IMAGE=

# Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=
KAFKA_PRODUCER_KEY_SERIALIZER=org.apache.kafka.common.serialization.StringSerializer
KAFKA_PRODUCER_VALUE_SERIALIZER=org.apache.kafka.common.serialization.StringSerializer
KAFKA_TOPIC_USER_REGISTERED=user-registered-events
KAFKA_TOPIC_USER_UPDATED=user-updated-events
KAFKA_TOPIC_USER_DELETED=user-deleted-events

# Redis
SPRING_REDIS_HOST=borshchevyk-redis
SPRING_REDIS_PORT=

# JPA
JPA_HIBERNATE_DDL-AUTO=update
JPA_DATABASE=postgresql

# JWT
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=
JWT_REFRESH_EXPIRATION_MS=

# Gateway
AUTH_SERVICE_URL=
USER_SERVICE_URL=
MESSAGE_SERVICE_URL=
SYNC_SERVICE_URL=

# Admin Service
ADMIN_USERNAME=
ADMIN_PASSWORD=
