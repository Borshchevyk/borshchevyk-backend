# Database Configuration
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
POSTGRES_DB_NAMES=borshchevyk_auth,borshchevyk_user,borshchevyk_chat,borshchevyk_message

# Kafka Configuration
KAFKA_BROKER_ID=
ZOOKEEPER_CLIENT_PORT=
ZOOKEEPER_TICK_TIME=
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1

# Spring Datasource
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Services configuration
GATEWAY_PORT=

AUTH_SERVICE_PORT=
AUTH_SERVICE_NAME=borshchevyk.auth
SPRING_DATASOURCE_URL_AUTH=

USER_SERVICE_PORT=
USER_SERVICE_NAME=borshchevyk.user
SPRING_DATASOURCE_URL_USER=

CHAT_SERVICE_PORT=
CHAT_SERVICE_NAME=borshchevyk.chat
SPRING_DATASOURCE_URL_CHAT=

# Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=
KAFKA_PRODUCER_KEY_SERIALIZER=org.apache.kafka.common.serialization.StringSerializer
KAFKA_PRODUCER_VALUE_SERIALIZER=org.apache.kafka.common.serialization.StringSerializer
KAFKA_TOPIC_USER_REGISTERED=user-registered-events
KAFKA_TOPIC_USER_UPDATED=user-updated-events
KAFKA_TOPIC_USER_DELETED=user-deleted-events

# Redis
SPRING_REDIS_HOST=borshchevyk-redis
SPRING_REDIS_PORT=

# JPA
JPA_HIBERNATE_DDL-AUTO=update
JPA_DATABASE=postgresql

# JWT
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=
JWT_REFRESH_EXPIRATION_MS=

# Gateway
AUTH_SERVICE_URL=
USER_SERVICE_URL=
MESSAGE_SERVICE_URL=http://message-service:8083
